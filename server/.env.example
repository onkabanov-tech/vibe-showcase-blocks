# Копируйте этот файл в .env и подставьте свои значения.
# .env в git не попадает (см. .gitignore в корне репозитория).

# Путь к файлу базы данных SQLite, относительно папки server/.
# Для тестов можно указать ":memory:" — база будет жить только в памяти процесса.
DB_PATH=./data/app.db

# Окружение выполнения: development | test | production
NODE_ENV=development

# Логин и пароль тестового администратора, которого создаёт npm run seed.
# В базу попадает только хеш пароля (см. docs/db-schema.md, требование 5).
# Только для локальной разработки — не используйте для реального продакшена.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme

# Пароль, который npm run seed ставит всем тестовым клиентским аккаунтам
# (логином служит email из seed.js). Только для локальной разработки.
SEED_CLIENT_PASSWORD=changeme

# Пароль тестового мастера с логином (см. seed.js — не у всех сидовых
# мастеров есть аккаунт). Только для локальной разработки.
SEED_MASTER_PASSWORD=changeme

# Порт, на котором слушает API (npm start).
PORT=3000

# Часовой пояс салона как смещение от UTC в минутах (180 = UTC+3, Москва).
# Используется только для перевода часов графика (work_schedule, местное
# время) в UTC при расчёте свободных слотов — см. docs/db-schema.md §5.
SALON_UTC_OFFSET_MINUTES=180

# Сколько минут держится удержание слота (POST /api/holds) до истечения.
HOLD_TTL_MINUTES=10

# Срок жизни токена сессии в часах — отдельно для клиентов, админки и мастеров.
CLIENT_SESSION_TTL_HOURS=720
ADMIN_SESSION_TTL_HOURS=12
MASTER_SESSION_TTL_HOURS=24
